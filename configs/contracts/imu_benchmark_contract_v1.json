{
  "contract_version": "imu_benchmark_contract_v1",
  "data_schema_version": "3.0.0",
  "canonical_signal": {
    "sampling_rate_hz": 30,
    "channels": 6,
    "axis_frame": "sensor_local",
    "gravity": "retained"
  },
  "device_reference_resampling": {
    "nominal_source_rate_hz": 25,
    "target_rate_hz": 30,
    "method": "monotonic_timestamp_linear_interpolation",
    "extrapolation": "forbidden",
    "ble_packet_timestamp_assignment": "out_of_scope"
  },
  "window": {
    "schema_version": "causal_segment_2s_stride_0p5s_features_v2",
    "external_schema_version": "causal_segment_2s_stride_0p5s_kfall_v2",
    "feature_schema_version": "window_features_v1",
    "samples": 60,
    "stride_samples": 15,
    "decision_sample": "last_sample"
  },
  "supervision": {
    "recording": {
      "pooling": "top_fraction_mean",
      "mil_top_fraction": 0.1
    },
    "temporal": {
      "positive_policy": "decision_time_within_fall_activity_segment",
      "post_segment_overlap_policy": "exclude",
      "exclude_overlap_policy": "exclude",
      "event_detection_policy": "single_window"
    }
  },
  "folds": {
    "count": 5,
    "seed": 3888,
    "evolution": "preserve_existing_assign_new_deterministically",
    "standard_protocol": "test_f_validation_next_train_remaining_three",
    "external_protocol": "participant_grouped_four_calibration_one_test"
  },
  "metrics": {
    "recording_primary": "balanced_accuracy",
    "temporal_primary": [
      "event_sensitivity",
      "adl_false_positive_windows_per_hour",
      "onset_latency_median_s",
      "onset_latency_p95_s",
      "impact_offset_median_s"
    ],
    "threshold_selection": "maximum_validation_balanced_accuracy"
  }
}
