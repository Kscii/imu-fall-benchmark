#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
WORK_ROOT="${IMU_BENCH_WORK_ROOT:-${HOME}/imu-fall-work}"
MINIFORGE_VERSION="26.3.2-2"
MINIFORGE_SHA256="42260ffe3830fb953d5eee1bbb32229ff06aa7c3833c1ed7a9a0420a95685d94"
MINIFORGE_URL="https://github.com/conda-forge/miniforge/releases/download/${MINIFORGE_VERSION}/Miniforge3-${MINIFORGE_VERSION}-Linux-x86_64.sh"
GCLOUD_VERSION="581.0.0"
GCLOUD_SHA256="deffdbe82ca6e3d19ffb291d063a651488e04e1b33799b5a238e4b5c6784e3c6"
GCLOUD_URL="https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-${GCLOUD_VERSION}-linux-x86_64.tar.gz"
SETUP_SCHEMA="imu-benchmark-wsl-environment-v2"
MIN_FREE_KIB=$((25 * 1024 * 1024))

if [[ -d /usr/lib/wsl/lib ]]; then
  export PATH="/usr/lib/wsl/lib:${PATH}"
fi

usage() {
  cat <<'EOF'
Usage: ./benchmark COMMAND [ARGS]

First use:
  ./benchmark setup       Install or reuse the pinned WSL2/CUDA environment
  ./benchmark data pull   Download and verify the current immutable datasets
  ./benchmark doctor      Verify WSL2, CUDA, data, and all model backends
  ./benchmark smoke       Run the capped seven-model temporal smoke test

Other commands:
  data status             Compare local data with remote current pointers
  data publish-base --source-dir PATH
                          Publish the reviewed public 25 Hz base snapshot
  test                    Run Ruff and pytest in the project environment
  validate-data           Validate active HDF5 v3.1 data and participant folds
  plan CONFIG.yaml        Resolve an experiment without training
  run CONFIG.yaml         Run a versioned experiment
  report RUN_ID           Regenerate a report from completed checkpoints
EOF
}

is_wsl2() {
  grep -Eqi 'microsoft-standard-wsl2' /proc/sys/kernel/osrelease 2>/dev/null
}

require_wsl2() {
  if ! is_wsl2; then
    echo "ERROR: this command is supported only inside WSL2." >&2
    exit 1
  fi
  case "${REPO_ROOT}" in
    /mnt/*)
      echo "ERROR: keep the repository in the WSL Linux filesystem, not under /mnt/." >&2
      exit 1
      ;;
  esac
}

require_absolute_work_root() {
  case "${WORK_ROOT}" in
    /*) ;;
    *)
      echo "ERROR: IMU_BENCH_WORK_ROOT must be an absolute path." >&2
      exit 1
      ;;
  esac
}

dependency_digest() {
  {
    printf '%s\n' "${SETUP_SCHEMA}"
    sha256sum "${REPO_ROOT}/environment.yml"
    sha256sum "${REPO_ROOT}/requirements-torch-cu129.txt"
  } | sha256sum | cut -c1-16
}

project_miniforge() {
  printf '%s/toolchains/miniforge-%s/bin/conda\n' "${WORK_ROOT}" "${MINIFORGE_VERSION}"
}

project_gcloud() {
  printf '%s/toolchains/google-cloud-sdk-%s/bin/gcloud\n' "${WORK_ROOT}" "${GCLOUD_VERSION}"
}

find_conda() {
  if [[ -n "${IMU_BENCH_CONDA_EXE:-}" ]]; then
    printf '%s\n' "${IMU_BENCH_CONDA_EXE}"
  elif [[ -x "${HOME}/miniforge3/bin/conda" ]]; then
    printf '%s\n' "${HOME}/miniforge3/bin/conda"
  else
    project_miniforge
  fi
}

find_gcloud() {
  if [[ -n "${IMU_BENCH_GCLOUD_EXE:-}" ]]; then
    printf '%s\n' "${IMU_BENCH_GCLOUD_EXE}"
  elif command -v gcloud >/dev/null 2>&1; then
    command -v gcloud
  else
    project_gcloud
  fi
}

environment_path() {
  printf '%s/envs/%s\n' "${WORK_ROOT}" "$(dependency_digest)"
}

require_download_tools() {
  command -v curl >/dev/null || {
    echo "ERROR: curl is required. Install: sudo apt install --yes curl ca-certificates" >&2
    exit 1
  }
  command -v tar >/dev/null || {
    echo "ERROR: tar is required. Install: sudo apt install --yes tar" >&2
    exit 1
  }
}

install_miniforge() {
  local destination installer temporary
  destination="${WORK_ROOT}/toolchains/miniforge-${MINIFORGE_VERSION}"
  [[ -x "${destination}/bin/conda" ]] && return
  require_download_tools
  temporary="$(mktemp -d)"
  installer="${temporary}/Miniforge3.sh"
  trap 'rm -rf -- "${temporary}"' RETURN
  curl --fail --location --retry 3 --output "${installer}" "${MINIFORGE_URL}"
  printf '%s  %s\n' "${MINIFORGE_SHA256}" "${installer}" | sha256sum --check --status
  mkdir -p -- "$(dirname -- "${destination}")"
  bash "${installer}" -b -p "${destination}"
  trap - RETURN
  rm -rf -- "${temporary}"
}

install_gcloud() {
  local destination archive temporary
  destination="${WORK_ROOT}/toolchains/google-cloud-sdk-${GCLOUD_VERSION}"
  [[ -x "${destination}/bin/gcloud" ]] && return
  require_download_tools
  temporary="$(mktemp -d)"
  archive="${temporary}/gcloud.tar.gz"
  trap 'rm -rf -- "${temporary}"' RETURN
  curl --fail --location --retry 3 --output "${archive}" "${GCLOUD_URL}"
  printf '%s  %s\n' "${GCLOUD_SHA256}" "${archive}" | sha256sum --check --status
  tar -xzf "${archive}" -C "${temporary}"
  mkdir -p -- "$(dirname -- "${destination}")"
  mv -- "${temporary}/google-cloud-sdk" "${destination}"
  trap - RETURN
  rm -rf -- "${temporary}"
}

setup_environment() {
  local conda_exe env_path free_kib marker
  require_wsl2
  require_absolute_work_root
  command -v git >/dev/null || {
    echo "ERROR: git is required. Install: sudo apt install --yes git" >&2
    exit 1
  }
  command -v sha256sum >/dev/null || {
    echo "ERROR: sha256sum is required (package: coreutils)." >&2
    exit 1
  }
  if ! command -v nvidia-smi >/dev/null && [[ ! -x /usr/lib/wsl/lib/nvidia-smi ]]; then
    echo "ERROR: nvidia-smi is unavailable inside WSL2." >&2
    exit 1
  fi
  mkdir -p -- "${WORK_ROOT}/envs" "${WORK_ROOT}/data" "${WORK_ROOT}/cache" \
    "${WORK_ROOT}/runs" "${WORK_ROOT}/toolchains"
  conda_exe="$(find_conda)"
  if [[ ! -x "${conda_exe}" ]]; then
    free_kib="$(df -Pk "${HOME}" | awk 'NR == 2 {print $4}')"
    if (( free_kib < MIN_FREE_KIB )); then
      echo "ERROR: at least 25 GiB free space is required for a fresh CUDA environment." >&2
      exit 1
    fi
    install_miniforge
    conda_exe="$(project_miniforge)"
  fi
  install_gcloud
  env_path="$(environment_path)"
  marker="${env_path}/.imu-benchmark-complete"
  if [[ ! -f "${marker}" ]]; then
    if [[ -e "${env_path}" ]]; then
      echo "ERROR: incomplete environment exists at ${env_path}; inspect it before retrying." >&2
      exit 1
    fi
    "${conda_exe}" env create --prefix "${env_path}" --file "${REPO_ROOT}/environment.yml"
    "${conda_exe}" run --prefix "${env_path}" \
      python -m pip install --requirement "${REPO_ROOT}/requirements-torch-cu129.txt"
    printf '%s\n' "$(dependency_digest)" >"${marker}"
  fi
  printf 'Environment ready: %s\nWork root: %s\nNext: ./benchmark data pull\n' \
    "${env_path}" "${WORK_ROOT}"
}

run_in_environment() {
  local conda_exe env_path gcloud_exe
  require_absolute_work_root
  conda_exe="$(find_conda)"
  env_path="$(environment_path)"
  gcloud_exe="$(find_gcloud)"
  if [[ ! -x "${conda_exe}" || ! -f "${env_path}/.imu-benchmark-complete" ]]; then
    echo "ERROR: the project environment is missing; run ./benchmark setup in WSL2." >&2
    exit 1
  fi
  if [[ ! -x "${gcloud_exe}" ]]; then
    echo "ERROR: gcloud is missing; rerun ./benchmark setup in WSL2." >&2
    exit 1
  fi
  PATH="$(dirname -- "${gcloud_exe}"):${PATH}" PYTHONPATH="${REPO_ROOT}/src" \
    "${conda_exe}" run --no-capture-output --prefix "${env_path}" "$@"
}

command="${1:-}"
case "${command}" in
  ""|-h|--help|help)
    usage
    ;;
  setup)
    shift
    if (( $# )); then
      echo "ERROR: setup does not accept arguments." >&2
      exit 2
    fi
    setup_environment
    ;;
  test)
    shift
    if (( $# )); then
      echo "ERROR: test does not accept arguments." >&2
      exit 2
    fi
    require_wsl2
    run_in_environment ruff check "${REPO_ROOT}"
    run_in_environment pytest -q "${REPO_ROOT}/tests"
    ;;
  *)
    require_wsl2
    run_in_environment python -m imu_benchmark.cli "$@"
    ;;
esac
